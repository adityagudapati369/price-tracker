# Copy this file to .env for LOCAL testing only.
# In GitHub Actions, these are set as repo Secrets instead (Settings > Secrets and variables > Actions).
# NEVER commit a real .env file — it's already in .gitignore.

# Supabase project URL (same one used by Groupverse: imnzgzusnghppgbgfdsh.supabase.co style)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE ROLE key (NOT the anon/public key) — this bypasses RLS so the
# scraper can write price data. Find it in Supabase Dashboard > Project Settings > API.
# Keep this secret. Never put it in frontend code.
SUPABASE_SERVICE_KEY=your-service-role-key-here
